{
  "_comment": "Scans THIS computer for real agents: Claude Desktop's MCP config, Claude Code's ~/.claude.json (user and per-project MCP servers), and running processes that look like agents or MCP servers (including the Job Search Agent started with `python app.py`). It also includes the made-up demo agents from examples/manifests, labelled 'demo' so they show a DEMO tag in the portal. Uses its own data folder (.data/laptop). The trust domain 'demo.local' is kept so the policy prefixes match; change both together if you want another name. The Job Search Agent's folder (../../job-search-agent) is read for its agent card; a running `python app.py` from that folder is merged into it.",
  "tool_policy_file": "laptop.tool-policy.json",
  "trust_domain": "demo.local",
  "server": {
    "data_dir": "../.data/laptop",
    "listen_host": "127.0.0.1",
    "listen_port": 8443,
    "tls_dns_names": [
      "localhost"
    ],
    "tls_ip_addresses": [
      "127.0.0.1"
    ],
    "ca_ttl_hours": 24,
    "x509_svid_ttl_minutes": 60,
    "jwt_svid_ttl_minutes": 5,
    "attested_svid_ttl_minutes": 30,
    "crl_validity_minutes": 5
  },
  "client": {
    "server_url": "https://127.0.0.1:8443",
    "bundle_file": "../.data/laptop/bundle.pem",
    "admin_token_env": "SPIFFE_ADMIN_TOKEN"
  },
  "portal": {
    "listen_host": "127.0.0.1",
    "listen_port": 8765,
    "scan_file": "../.data/laptop/last-scan.json"
  },
  "discovery": {
    "ai_agents": {
      "manifest_dirs": [
        {
          "path": "~/Library/Application Support/Claude",
          "max_depth": 1
        },
        {
          "path": "manifests",
          "max_depth": 3,
          "label": "demo"
        },
        {
          "path": "../../job-search-agent",
          "max_depth": 1
        }
      ],
      "manifest_files": [
        "~/.claude.json"
      ]
    },
    "processes": {
      "method": "ps",
      "include": [
        "python*",
        "Python*",
        "node",
        "npx",
        "uvx"
      ],
      "cmdline_contains": [
        "app.py",
        "mcp",
        "modelcontextprotocol"
      ]
    }
  },
  "policy": {
    "rules": [
      {
        "name": "a2a-agents",
        "match": {
          "source": "ai-agents",
          "kind": "ai-agent"
        },
        "spiffe_id_path": "/ai-agent/{name}"
      },
      {
        "name": "mcp-servers-with-transport",
        "match": {
          "source": "ai-agents",
          "kind": "mcp-server",
          "attributes": {
            "transport": "*"
          }
        },
        "spiffe_id_path": "/mcp/{attr.transport}/{name}"
      },
      {
        "name": "job-search-agent",
        "match": {
          "kind": "process",
          "attributes": {
            "cmdline": "*app.py*",
            "cwd": "*/job-search-agent"
          }
        },
        "spiffe_id_path": "/agent/job-search-agent"
      }
    ]
  },
  "llm": {
    "enabled": false,
    "model": "claude-opus-5-5",
    "send_attributes": [
      "protocol",
      "transport",
      "agent_name",
      "server_name",
      "skills"
    ]
  }
}
