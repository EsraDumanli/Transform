{
  "_comment": "Tool policy for examples/laptop.config.json: deny by default. Allows reading only Claude Desktop's config folder, Claude Code's ~/.claude.json and the demo fixtures in examples/manifests, listing processes with ps, the local SPIFFE server, identities under /ai-agent, /mcp, /agent/job-search-agent and /mac, device attestation, revocation and delegation grants (at most 60 minutes). Kubernetes, Docker, network scans, A2A probes and the LLM are blocked.",
  "version": 1,
  "default": "deny",
  "trace": {
    "file": "../.data/laptop/trace.jsonl"
  },
  "tools": {
    "discovery.ai_agents.read_manifests": {
      "paths": [
        "~/Library/Application Support/Claude",
        "~/.claude.json",
        "manifests",
        "../../job-search-agent"
      ]
    },
    "server.connect": {
      "urls": [
        "https://127.0.0.1:8443"
      ]
    },
    "server.entries.list": {},
    "server.entries.create": {
      "spiffe_id_prefixes": [
        "spiffe://demo.local/ai-agent/",
        "spiffe://demo.local/mcp/",
        "spiffe://demo.local/agent/job-search-agent",
        "spiffe://demo.local/mac/"
      ]
    },
    "server.entries.delete": {},
    "server.svid.x509": {
      "spiffe_id_prefixes": [
        "spiffe://demo.local/ai-agent/",
        "spiffe://demo.local/mcp/",
        "spiffe://demo.local/agent/job-search-agent",
        "spiffe://demo.local/mac/"
      ]
    },
    "server.svid.jwt": {
      "spiffe_id_prefixes": [
        "spiffe://demo.local/ai-agent/",
        "spiffe://demo.local/mcp/",
        "spiffe://demo.local/agent/job-search-agent",
        "spiffe://demo.local/mac/"
      ],
      "audiences": [
        "ticket-api"
      ]
    },
    "portal.scan": {},
    "portal.approve": {},
    "portal.revoke": {},
    "server.nodes.enroll": {
      "max_pending": 5
    },
    "server.nodes.list": {},
    "server.nodes.manage": {},
    "server.nodes.challenge": {},
    "server.svid.attested": {
      "spiffe_id_prefixes": [
        "spiffe://demo.local/mac/"
      ],
      "max_ttl_minutes": 30,
      "require_hardened_runtime": true
    },
    "portal.devices": {},
    "portal.builds": {},
    "server.svid.list_issued": {},
    "server.svid.revoke": {
      "reasons": [
        "key_compromise",
        "device_lost",
        "superseded",
        "decommissioned",
        "policy_violation"
      ]
    },
    "portal.revoke_identity": {},
    "server.grants.create": {
      "max_grant_minutes": 60,
      "allowed_scope_types": [
        "tool",
        "data:path",
        "data:host"
      ]
    },
    "server.grants.list": {},
    "server.grants.withdraw": {},
    "portal.grants": {},
    "discovery.processes.read": {
      "methods": [
        "ps"
      ]
    }
  },
  "attestation_rubric": {
    "_comment": "Owner decisions: no method is High without Apple attestation (none available without MDM / a Developer membership). Medium means device and program both verified, or a trusted platform observation. Unlisted methods are Low.",
    "macos-se-node+codesign": "medium",
    "macos-codesign-parent": "low",
    "macos-se-node": "low",
    "k8s-api": "medium",
    "docker-image": "medium",
    "process-path": "medium",
    "process-name": "low",
    "a2a-card": "low",
    "mcp-config": "low",
    "network-addr": "low"
  }
}
