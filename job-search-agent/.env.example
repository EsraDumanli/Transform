# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use for searching/scoring. Any Claude model with web search
# tool support works; check https://docs.claude.com/en/docs/about-claude/models
# for the current list. Defaults to a fast, capable model.
JOB_AGENT_MODEL=claude-sonnet-5

# Required in practice: Flask secret key, used to sign session cookies (login
# state) and CSRF tokens. Use a long random string, and keep it the same
# across restarts or everyone gets logged out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-something-random

# Optional: set to 1 once this is served over HTTPS, so session/remember-me
# cookies are only ever sent over an encrypted connection. Leave at 0 for
# local development over plain http://.
SESSION_COOKIE_SECURE=0

# Optional: where uploaded resumes and the SQLite database are stored.
JOB_AGENT_DATA_DIR=./data
